# Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# App Configuration
VITE_APP_URL=http://localhost:5173

# PostgreSQL Database Configuration (Required for admin panel and database scripts)
# These variables are used by psql scripts in this project.
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_secure_password
DB_PORT=5432
DB_USER=your_database_user

# Server Configuration
SERVER_PORT=3001
VITE_API_URL=http://localhost:3001/api

# GraphQL Live Data Endpoint (for product sync)
GRAPHQL_ENDPOINT=https://www.bathroommountain.co.uk/graphql
